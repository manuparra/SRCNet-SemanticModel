<https://example.org/srcnet/espSRC/deployment/espsrc-skaha/production> a sv:Deployment ;
    schema:description "Known configuration, not current health. Earlier PVC and metrics-backend incidents do not establish present availability. Chart and image versions are intentionally separate." ;
    schema:name "Skaha session service deployment" ;
    sv:administration <https://example.org/srcnet/espSRC/administration/espsrc-skaha> ;
    sv:allocation <https://example.org/srcnet/espSRC/allocation/espsrc-skaha>,
        <https://example.org/srcnet/espSRC/storage-allocation/espsrc-skaha> ;
    sv:dependency <https://example.org/srcnet/espSRC/dependency/espsrc-skaha/authentication>,
        <https://example.org/srcnet/espSRC/dependency/espsrc-skaha/espsrc-cavern> ;
    sv:environment "production" ;
    sv:evidence <https://example.org/srcnet/espSRC/evidence/operator-report-2026-10-02> ;
    sv:hostedAt <https://example.org/srcnet/espSRC/site/iaa> ;
    sv:namespace "skaha-system" ;
    sv:operational <https://example.org/srcnet/espSRC/operational/espsrc-skaha> ;
    sv:realizesService <https://w3id.org/srcnet/service/espsrc-notebook>,
        <https://w3id.org/srcnet/service/espsrc-skaha> ;
    sv:releaseName "espsrccanfar-science-platform" ;
    sv:security <https://example.org/srcnet/espSRC/security/canfar> ;
    sv:software <https://example.org/srcnet/espSRC/release/skaha-chart/1.7.0>,
        <https://example.org/srcnet/espSRC/release/skaha/1.4.0> ;
    sv:workloadNamespace "skaha-workload" .

