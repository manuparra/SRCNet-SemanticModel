PREFIX sv: <https://w3id.org/srcnet/services#>
PREFIX schema: <https://schema.org/>
SELECT ?deployment ?dependency ?target ?scope ?evidenceStatus WHERE {
  ?deployment sv:dependency ?dependency .
  ?dependency sv:targetService ?target ; sv:evidence/sv:evidenceStatus ?evidenceStatus .
  ?target sv:scope ?scope .
} ORDER BY ?deployment ?target
